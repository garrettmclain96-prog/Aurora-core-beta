# Aurora Core — Environment Variables (root Vite app + /api serverless functions)
# For local dev, copy this file to .env.local and fill in real values.
# For production, add these in your Vercel project dashboard under
# Settings → Environment Variables. Never commit real secret values.
#
# Note: aurora-core-os/ is a separate backend project with its own
# .env.example — these variables are unrelated to it.

# ── Auth (Clerk) — required ─────────────────────────────────────────────
# From your Clerk Dashboard → API Keys. The publishable key is safe to
# expose client-side (it's baked into the browser bundle). The secret key
# must only ever live in a server environment — never in git, never sent
# to the browser.
#
# The publishable key is accepted under ANY of three names, so it can be
# pasted across from Clerk unchanged no matter which one you copied. Set one:
CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...        (this project's native form)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_... (what the dashboard shows)

# Server-only. Never prefixed, never inlined into the browser bundle.
CLERK_SECRET_KEY=sk_test_...

# Which account gets the top 'god' role, checked server-side on every request.
# GOD_USER_ID wins if set and is the more reliable option — a Clerk user id is
# immutable, so it survives an email change and works no matter which address
# you signed up with. Find it in Clerk Dashboard → Users → (your user) → the
# `user_...` id. Leave unset to fall back to matching the primary email below.
# GOD_USER_ID=user_...
# GOD_EMAIL=you@example.com

# ── AI chat (optional but recommended) ──────────────────────────────────
# Powers /api/chat (AI Chat, Simulation "Analyze with AI", JARVIS text).
# Anthropic is tried first; Groq is a free fallback. Without either,
# chat endpoints return a friendly "not configured" error.
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# ── JARVIS voice (optional) ─────────────────────────────────────────────
# Powers /api/Jarvis (speech-to-text via Whisper, reply via GPT-4o-mini,
# text-to-speech). Without it, voice mode is unavailable but text chat
# still works via ANTHROPIC_API_KEY/GROQ_API_KEY above.
OPENAI_API_KEY=sk-...

# ── ESP32 telemetry ingest (optional, required to accept device data) ──
# Shared secret the ESP32-C6 sends as `Authorization: Bearer <secret>`
# when POSTing to /api/ingest. Without this set, POST /api/ingest refuses
# all writes (fails closed) — GET (read latest snapshot) still works.
INGEST_SECRET=your-esp32-shared-secret
