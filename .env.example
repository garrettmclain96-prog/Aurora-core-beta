# Aurora Core — Environment Variables
# For local dev, copy this file to .env.local and fill in real values.
# For production, add these in your Vercel project dashboard under
# Settings → Environment Variables. Never commit real secret values.

# ── Auth (Clerk) ────────────────────────────────────────────────────────
# From your Clerk Dashboard → API Keys. The publishable key is safe to
# expose client-side (it's baked into the browser bundle). The secret key
# must only ever live in a server environment (Vercel env vars / .env.local)
# — never in git, never sent to the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── AI chat (optional) ──────────────────────────────────────────────────
# Required for the AI Chat and Simulation "Analyze with AI" features.
# Without it, /api/chat falls back to GROQ_API_KEY (free) if set, or
# returns a friendly "not configured" error.
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
